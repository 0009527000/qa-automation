{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "① 运行全部用例（推荐）",
      "detail": "run.bat -> launcher.py -> runner.py，零第三方依赖",
      "type": "process",
      "command": "cmd",
      "args": ["/c", "run.bat"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "QA_NO_PAUSE": "1", "PYTHONUTF8": "1" }
      },
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true, "focus": true },
      "problemMatcher": []
    },
    {
      "label": "② 只跑冒烟用例",
      "type": "process",
      "command": "cmd",
      "args": ["/c", "run.bat", "--tag", "smoke"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "QA_NO_PAUSE": "1", "PYTHONUTF8": "1" }
      },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "③ 一键自检（跑用例 + 历史统计）",
      "type": "process",
      "command": "cmd",
      "args": ["/c", "verify.bat"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "QA_NO_PAUSE": "1", "PYTHONUTF8": "1" }
      },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "④ 环境体检（跑不动先点这个）",
      "detail": "检查 Python / 端口 8000 / 数据库是否可用，不跑用例",
      "type": "process",
      "command": "cmd",
      "args": ["/c", "run.bat", "check"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "QA_NO_PAUSE": "1", "PYTHONUTF8": "1" }
      },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "⑤ 查看执行统计",
      "type": "process",
      "command": "cmd",
      "args": ["/c", "run.bat", "report", "--md"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "QA_NO_PAUSE": "1", "PYTHONUTF8": "1" }
      },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "⑥ 缺陷台账",
      "type": "process",
      "command": "cmd",
      "args": ["/c", "run.bat", "bugs", "list"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "QA_NO_PAUSE": "1", "PYTHONUTF8": "1" }
      },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "⑦ 生成 HTML 报告并打开",
      "detail": "reports/report.html，浏览器可 Ctrl+P 存成 PDF",
      "type": "process",
      "command": "cmd",
      "args": ["/c", "run.bat", "html", "--open"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "QA_NO_PAUSE": "1", "PYTHONUTF8": "1" }
      },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    }
  ]
}
