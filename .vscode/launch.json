{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "① 运行全部用例（推荐）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/launcher.py",
      "args": ["run"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONUTF8": "1", "PYTHONIOENCODING": "utf-8" },
      "justMyCode": true
    },
    {
      "name": "② 只跑冒烟用例",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/launcher.py",
      "args": ["run", "--tag", "smoke"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONUTF8": "1", "PYTHONIOENCODING": "utf-8" }
    },
    {
      "name": "③ 一键自检",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/launcher.py",
      "args": ["verify"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONUTF8": "1", "PYTHONIOENCODING": "utf-8" }
    },
    {
      "name": "④ 查看执行统计",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/launcher.py",
      "args": ["report", "--md"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONUTF8": "1", "PYTHONIOENCODING": "utf-8" }
    },
    {
      "name": "⑤ 环境体检（跑不动先选这个）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/launcher.py",
      "args": ["check"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONUTF8": "1", "PYTHONIOENCODING": "utf-8" }
    }
  ]
}
